// prisma/schema.prisma
// Schema para persistência de parceiros (ONGs, coletivos, instituições)
// do Hub de Parceiros do Caminhos Campinas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Optional: only needed for Prisma Accelerate/connection pooling
}

/// Partner model - NGOs, Government agencies, and Companies supporting homeless population
/// Registered through /parceiros form, moderated before public display
model Partner {
  id          String   @id @default(uuid())
  name        String   /// Organization name
  category    String   /// Enum-like: "NGO", "GOV", "COMPANY"
  whatsapp    String?  /// Contact via WhatsApp
  description String?  /// Service description
  pixKey      String?  /// PIX key for donations
  address     String?  /// Physical address
  status      String   @default("PENDING") /// PENDING, APPROVED, REJECTED
  latitude    Float?   @map("latitude")   /// Geolocation for map display
  longitude   Float?   @map("longitude")
  createdAt   DateTime @default(now())

  @@index([category, status])  /// Fast filtering by category and status
  @@index([createdAt])          /// Fast sorting by creation date
  @@map("partners")
}

/// User feedback on dilemma realism - helps validate narrative accuracy
model DilemmaFeedback {
  id          String   @id @default(uuid())
  dilemmaId   String   /// Reference to dilemma in JSON data
  userId      String   /// Anonymous user identifier
  isRealistic Boolean  /// True if user considers dilemma realistic
  comment     String?  /// Optional feedback text
  createdAt   DateTime @default(now())

  @@index([dilemmaId])          /// Fast lookup by dilemma
  @@index([createdAt])          /// Time-based analysis
  @@map("dilemma_feedbacks")
}

/// Community posts - Jornal da Rua content (reports, stories, poetry)
model Post {
  id        String   @id @default(uuid())
  title     String?
  content   String   /// Post content (markdown supported)
  author    String?  /// Optional (anonymous allowed)
  contact   String?  /// For follow-up
  category  String   /// DENUNCIA, RELATO, POESIA
  status    String   @default("PENDING") /// PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  
  @@index([category, status])   /// Fast filtering by category and status
  @@index([createdAt])          /// Chronological sorting
  @@map("posts")
}

/// Telemetry Data - Synchronized from offline play sessions
model TelemetryEvent {
  id        String   @id @default(uuid())
  sessionId String   /// Client-side session ID
  eventType String   /// SHOCK_EVENT, GAME_START, etc.
  payload   Json     /// Flexible payload data
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@map("telemetry_events")
}

/// User Stories/Dilemmas - Collected from /sugerir and synchronized
model CommunityStory {
  id         String   @id @default(uuid())
  content    String   /// The story text
  source     String   /// e.g. "web-offline-form", "whatsapp"
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("community_stories")
}
