// prisma/schema.prisma
// Schema para persistência de parceiros (ONGs, coletivos, instituições)
// do Hub de Parceiros do Caminhos Campinas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Partner {
  id          String   @id @default(uuid())
  name        String
  category    String   // Enum-like: "NGO", "GOV", "COMPANY"
  whatsapp    String?
  description String?
  pixKey      String?
  address     String?
  status      String   @default("PENDING")
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())

  @@map("partners")
}

model DilemmaFeedback {
  id          String   @id @default(uuid())
  dilemmaId   String
  userId      String
  isRealistic Boolean
  comment     String?
  createdAt   DateTime @default(now())

  @@map("dilemma_feedbacks")
}

model Post {
  id        String   @id @default(uuid())
  title     String?
  content   String
  author    String?  // Opcional (anônimo)
  contact   String?  // Para contato
  category  String   // DENUNCIA, RELATO, POESIA
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  
  @@map("posts")
}
