# Pop Rua Game - Variáveis de Ambiente

# GROQ API (Free Tier - Fast Llama Models)
# Obtenha sua chave GRATUITA em: https://console.groq.com/keys
# Não precisa de cartão de crédito!
GROQ_API_KEY=your_groq_api_key_here

# Auth (NextAuth)
# Gere um segredo no terminal com: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here-must-be-set
AUTH_URL=http://localhost:5173

# Google OAuth (Opcional - necessário para login com Google)
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...

# DATABASE (Vercel Postgres ou Supabase - OBRIGATÓRIO para Hub de Parceiros)
# Obtenha em: Vercel Dashboard > Storage > Postgres > Connect
# ou: Supabase > Project Settings > Database > Connection String
# Database (PostgreSQL / Prisma Accelerate)
# Use a URL do Accelerate (prisma+postgres://) aqui para pooling em produção (ex: Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
# Use a URL Direta (postgres://) aqui para migrações (ex: Supabase)
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# GOOGLE ANALYTICS
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
